PORT=8787
PUBLIC_BASE_URL=https://your-domain.example

# Optional AI analysis. Without it, local rule-based analysis is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Use the Galaxy A26 app as the cellular dialing gateway.
# Copy Device ID from the Android app screen.
A26_GATEWAY_DEVICE_ID=

# Optional generic telephony adapter for full AI audio / SIP / GSM-LTE bridge.
TELEPHONY_WEBHOOK_URL=
TELEPHONY_TOKEN=
